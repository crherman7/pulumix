{
  "name": "@pulumix/core",
  "version": "0.13.0",
  "description": "Core types, managers, and orchestrator for Pulumix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crherman7/pulumix.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/crherman7/pulumix",
  "bugs": {
    "url": "https://github.com/crherman7/pulumix/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./schema": {
      "default": "./src/schemas/service-manifest.schema.json"
    }
  },
  "files": [
    "dist",
    "src/schemas"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@balena/dockerignore": "^1.0.2",
    "@pulumi/pulumi": "^3.142.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dockerfile-ast": "^0.7.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "purify-ts": "^2.1.0",
    "yaml": "^2.6.1",
    "@kubernetes/client-node": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
