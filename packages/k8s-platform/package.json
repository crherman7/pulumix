{
  "name": "@pulumix/k8s-platform",
  "version": "0.10.0",
  "description": "Kubernetes compute primitives for Pulumix services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crherman7/pulumix.git",
    "directory": "packages/k8s-platform"
  },
  "homepage": "https://github.com/crherman7/pulumix",
  "bugs": {
    "url": "https://github.com/crherman7/pulumix/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@pulumix/core": "workspace:*"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "^3.0.0",
    "@pulumi/kubernetes": "^4.0.0"
  },
  "devDependencies": {
    "@pulumi/pulumi": "^3.142.0",
    "@pulumi/kubernetes": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
