{
  "name": "@pulumix/cli",
  "version": "0.0.0",
  "description": "CLI for Pulumix deployment orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pulumix": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@pulumix/core": "workspace:*",
    "ansi-diff": "^1.1.1",
    "chalk": "^4.1.2",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
